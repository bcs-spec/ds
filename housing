import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_absolute_error,mean_squared_error,r2_score
df=pd.read_csv('housing.csv')
df=pd.get_dummies(df,dummy_na=True).fillna(0)
target='median_house_value'
X=df.drop(columns=[target]); y=df[target]
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
m=RandomForestRegressor(random_state=1).fit(Xtr,ytr); p=m.predict(Xte)
print('MAE:',mean_absolute_error(yte,p))
print('RMSE:',mean_squared_error(yte,p)**.5); print('R2:',r2_score(yte,p))
