import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
df=pd.read_csv('Salary_Data.csv').dropna()
X=df[['YearsExperience']]; y=df['Salary']
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
m=LinearRegression().fit(Xtr,ytr); p=m.predict(Xte)
print('MSE:',mean_squared_error(yte,p))
plt.scatter(X,y); plt.plot(X,m.predict(X),color='red'); plt.show()
