import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score,confusion_matrix,classification_report
df=pd.read_csv('spambase.csv',header=None).dropna()
X=df.iloc[:,:-1]; y=df.iloc[:,-1]
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
sc=StandardScaler(); Xtr=sc.fit_transform(Xtr); Xte=sc.transform(Xte)
m=KNeighborsClassifier(n_neighbors=5).fit(Xtr,ytr); p=m.predict(Xte)
print(accuracy_score(yte,p)); print(confusion_matrix(yte,p))
print(classification_report(yte,p))
