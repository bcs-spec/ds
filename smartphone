
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score,confusion_matrix,f1_score
df=pd.read_csv('train.csv').dropna()
target='price_range'
X=df.drop(columns=[target]); y=df[target]
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
m=LogisticRegression(max_iter=1000).fit(Xtr,ytr); p=m.predict(Xte)
print('Accuracy:',accuracy_score(yte,p)); print('F1:',f1_score(yte,p,average='weighted'))
print(confusion_matrix(yte,p))
