import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score,confusion_matrix
df=pd.read_csv('student_dataset_v2.csv').dropna()
target='Performance' if 'Performance' in df.columns else df.columns[-1]
X=df.select_dtypes(include='number').drop(columns=[target],errors='ignore')
y=df[target]
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
sc=StandardScaler(); Xtr=sc.fit_transform(Xtr); Xte=sc.transform(Xte)
m=KNeighborsClassifier(5).fit(Xtr,ytr); p=m.predict(Xte)
print('Accuracy:',accuracy_score(yte,p)); print(confusion_matrix(yte,p))
