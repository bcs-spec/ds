import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score,confusion_matrix
df=pd.read_csv('Mall_Customers.csv').dropna()
# Choose numeric features and an existing segment/class label
X=df[['Age','Annual Income (k$)','Spending Score (1-100)']]
y=(df['Spending Score (1-100)']>50).astype(int)
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
sc=StandardScaler(); Xtr=sc.fit_transform(Xtr); Xte=sc.transform(Xte)
m=KNeighborsClassifier(5).fit(Xtr,ytr); p=m.predict(Xte)
print(accuracy_score(yte,p)); print(confusion_matrix(yte,p))
