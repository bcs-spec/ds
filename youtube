import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
df=pd.read_csv('USvideos.csv').dropna(subset=['views','likes'])
X=df[['likes']]; y=df['views']
Xtr,Xte,ytr,yte=train_test_split(X,y,test_size=.2,random_state=1)
m=LinearRegression().fit(Xtr,ytr); p=m.predict(Xte)
print('MSE:',mean_squared_error(yte,p))
plt.scatter(Xte,yte); plt.plot(Xte,p,color='red'); plt.show()
