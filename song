import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error,mean_squared_error,r2_score
df=pd.read_csv('Spotify -Raw Data.csv').dropna()
X=df[['danceability','energy','tempo']]; y=df['popularity']
xp=PolynomialFeatures(2).fit_transform(X)
m=LinearRegression().fit(xp,y); p=m.predict(xp)
print('MAE:',mean_absolute_error(y,p),'RMSE:',mean_squared_error(y,p)**.5,'R2:',r2_score
 (y,p))
plt.scatter(y,p); plt.xlabel('Actual'); plt.ylabel('Predicted'); plt.show()
