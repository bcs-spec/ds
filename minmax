import pandas as pd
from sklearn.preprocessing import MinMaxScaler, StandardScaler, Normalizer
df=pd.DataFrame({'Temperature':[20,25,30,35],'Humidity':[40,50,60,70],
 'Wind_Speed':[5,10,15,20],'Pressure':[1000,1005,1010,1015],
 'Rainfall':[0,10,20,30]})
print('Min-Max:\n',MinMaxScaler().fit_transform(df))
print('Standard:\n',StandardScaler().fit_transform(df))
print('Normalize:\n',Normalizer().fit_transform(df))
