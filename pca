import pandas as pd
from sklearn.feature_selection import SelectKBest, f_classif
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
df = pd.DataFrame({
 'Age':[22,30,25,40,35,28,45,32,50,26],
 'Income':[20,40,25,60,50,30,70,45,80,28],
 'Credit_Score':[600,700,620,750,720,650,780,710,800,630],
 'Loan_Amount':[10,20,15,30,25,12,35,22,40,14],
 'Employment_Years':[1,5,2,10,8,3,12,6,15,2],
 'Debt_Ratio':[.4,.2,.5,.1,.2,.4,.1,.3,.1,.5],
 'Loan_Status':[0,1,0,1,1,0,1,1,1,0]})
X=df.drop('Loan_Status',axis=1); y=df['Loan_Status']
s=SelectKBest(f_classif,k=3); s.fit(X,y)
print('Selected:',X.columns[s.get_support()].tolist())
Xs=StandardScaler().fit_transform(X)
print('PCA:',PCA(n_components=2).fit_transform(Xs))
